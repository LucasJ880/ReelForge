# 生产环境必填（在 Vercel Dashboard 的 Environment Variables 里逐项添加）

DATABASE_URL=
AUTH_SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# 成片合成：默认 inprocess（/api/cron/stitch-dispatch 函数内合成），不要设成 local。
# 回滚到 GitHub runner：STITCH_RUNTIME=external（此时才需要下面的 dispatch token）。
# STITCH_RUNTIME=
GITHUB_STITCH_DISPATCH_TOKEN=
# Vercel 自动提供 repository/ref；自托管环境才需要显式填写
# GITHUB_STITCH_REPOSITORY=LucasJ880/ReelForge
# GITHUB_STITCH_REF=main

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

OPENAI_API_KEY=
# 生产 key 只有 gpt-5.6 系权限；显式设 4 系会被沉到回退链尾而不是报错
OPENAI_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
PRODUCT_IMAGE_RATE_LIMIT_PER_HOUR=5
# 验证/预览环境设 true；生产留空或 false 后只由用户主动触发真实图片调用
IMAGE_ENGINE_MOCK=true
# 主播参考图（P02-D(s)）：off|internal|on；internal 只放 SUPER_ADMIN/OPERATOR（E15 实验）。默认 off。
# STORYBOARD_PERSON_REFS=off
# 批量故事板 AI 审帧（P01-D，D-1）：off|shadow|block，默认 off。
# shadow = AUTO 故事板照常直接批准，批量 tick 预算内旁路审一次、只记 aiReview；
# block = AUTO 故事板出完图先审帧，不过的帧按审帧意见重抽（每帧最多 2 次），全过或兜底后才批准。需 OpenAI vision 额度。
# STORYBOARD_AI_REVIEW=off
# 段级漂移判据（P01-B，影子）：off|shadow，默认 off。shadow 只记 frameQaDetail.drift、不拦截；
# 每段多一次 vision 调用（需 OpenAI 额度），E13 校准前不要转 block。
# FRAME_QA_DRIFT_MODE=off

BYTEPLUS_ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_VIDEO_MODEL=dreamina-seedance-2-0-260128
ARK_VIDEO_I2V_MODEL=
VIDEO_ENGINE_MOCK=true
CONTENT_REVIEW_ENABLED=false
CONTENT_REVIEW_PROVIDER=openai_moderation
CONTENT_REVIEW_MOCK=true
AI_DISCLOSURE_END_CARD_ENABLED=false
NEXT_PUBLIC_PRIVACY_EMAIL=
# Shuyu API key. `shuyu_api_key` remains a compatibility alias.
SHUYU_API_KEY=
shuyu_api_key=
# 图文帖（单图 / 轮播）配图线路：默认 shuyu（异步出图：提交后由 GET 轮询与 cron 对账收图）；
# openai = 回滚到原同步 gpt-image 线路（代码原样保留）。不设或写别的值都按 shuyu。
# CONTENT_POST_IMAGE_PROVIDER=shuyu
# Comma-separated hosts allowed to serve Shuyu output images. When set it fully
# replaces the built-in fallback, so list every current host. Shuyu moved its
# outputs to a Cloudflare R2 bucket (pub-...r2.dev) in 2026-07. REQUIRED in prod
# until the built-in fallback tracks the live host.
SHUYU_OUTPUT_HOST_ALLOWLIST=shuyu-tiktok-tool.pages.dev,ark-acg-cn-beijing.tos-cn-beijing.volces.com,pub-e3efa798bda34fd0a8bf550fca3b297f.r2.dev

APIFY_TOKEN=
APIFY_TIKTOK_VIDEO_ACTOR=

# 可选
REMOVE_BG_API_KEY=
# 产品锚点待抠图续跑挂 poll-videos cron（每轮最多 5 个、总预算 20s）；默认关，抠图 key 到位后再设 on
# PRODUCT_ANCHOR_CUTOUT_CRON=on
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# 租户与安全边界（2026-10-23 PR-0）：见 .env.example 同名段落
GLOBAL_BRAND_PACKAGE_USERS=
QINGYAN_SYNC_OWNER_USER_IDS=
