{
  "name": "aivora",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "prisma generate && tsx scripts/check-real-mode.ts || true",
    "dev": "next dev",
    "dev:mock": "LLM_FORCE_MOCK=true VIDEO_ENGINE_MOCK=true IMAGE_ENGINE_MOCK=true VIDEO_ENGINE_MOCK_LATENCY_MS=0 npm run dev",
    "cleanup:library:dead": "node --env-file-if-exists=.env.local --import tsx scripts/cleanup-dead-library-records.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:prod-smoke": "playwright test --config=playwright.prod-smoke.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/confirm-production-db.mjs db:migrate && dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local -- sh -c 'DATABASE_URL=\"$NEON_PRODUCTION_OWNER_DATABASE_URL\" prisma migrate deploy'",
    "db:migrate:deploy:unlock": "dotenv -e .env.local -- sh -c 'DATABASE_URL=\"$NEON_PRODUCTION_OWNER_DATABASE_URL\" PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=true prisma migrate deploy'",
    "db:push": "node scripts/confirm-production-db.mjs db:push && dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "postinstall": "prisma generate",
    "db:seed": "node scripts/confirm-production-db.mjs db:seed && dotenv -e .env.local -- tsx prisma/seed.ts",
    "ops:rotate-leaked-passwords": "node scripts/confirm-production-db.mjs ops:rotate-leaked-passwords && dotenv -e .env.local -- tsx scripts/rotate-leaked-passwords.ts",
    "codemap:build": "tsx scripts/build-codemap.ts",
    "context:find": "tsx scripts/context-router.ts",
    "context:video": "tsx scripts/context-router.ts video generation ffmpeg demo blob",
    "tokens:generate": "tsx scripts/generate-design-tokens.ts",
    "frame:qa": "tsx scripts/frame-qa.ts",
    "eval:video": "tsx scripts/eval/video-golden-set.ts",
    "director": "tsx scripts/director/run.ts",
    "eval:shot-cards": "tsx --env-file=.env.local scripts/eval/shot-card-latency.ts",
    "report:feedback": "tsx --env-file=.env.local scripts/ops/video-feedback-report.ts",
    "e2e:phase4:mock": "node --import tsx --test tests/personal-status-customer-safe.test.ts tests/personal-customer-strings.test.ts tests/unified-creative-strategist.test.ts tests/seedance-privacy-fallback.test.ts",
    "mode:check": "tsx scripts/check-real-mode.ts",
    "mode:check:strict": "tsx scripts/check-real-mode.ts -- --strict",
    "roadmap": "tsx scripts/roadmap.ts",
    "pretest": "node scripts/check-node-version.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@expo-google-fonts/noto-sans-sc": "0.4.4",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "openai": "^6.46.0",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.2",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
